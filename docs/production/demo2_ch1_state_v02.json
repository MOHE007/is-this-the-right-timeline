{
  "schema_version": "1.0",
  "id": "demo2_ch1_state",
  "version": "v02",
  "title": "第一章南宋意难平｜探索状态契约",
  "status": "draft-for-integration",
  "extends": "demo2_ch1_state_v01.json",
  "design_rules": {
    "evidence_layers": ["physical", "eligibility", "shan_verified"],
    "failure_mode": "continue_with_explicit_consequence",
    "demo1_preserved": true
  },
  "initial_state_patch": {
    "clue_fragments": [],
    "verified_clues": [],
    "route_verified": false,
    "recall_recipient_token": false,
    "recall_recipient_found": false,
    "shan_answer_recall": false,
    "testimony_interpreted": false,
    "missed_critical_clues": [],
    "shan_questions_left": 3,
    "investigation_counts": {"s05_station": 0, "s06_ferry": 0, "s07_military_town": 0}
  },
  "effects_catalog_patch": {
    "find_route_map_fragment": {"append_unique": {"clue_fragments": "route_map_fragment"}},
    "find_recall_recipient_token": {"set": {"recall_recipient_token": true}},
    "find_recall_recipient": {"set": {"recall_recipient_found": true}},
    "verify_route": {"append_unique": {"verified_clues": "route_map"}, "set": {"route_verified": true}},
    "verify_recall_chain": {"append_unique": {"verified_clues": "military_order"}, "set": {"shan_answer_recall": true}},
    "verify_recipient": {"append_unique": {"verified_clues": "recall_recipient_token"}, "set": {"recall_recipient_found": true}},
    "verify_testimony": {"append_unique": {"verified_clues": "civilian_testimony"}, "set": {"testimony_interpreted": true}},
    "record_ferry_register": {"append_unique": {"clue_fragments": "ferry_register"}},
    "consume_shan_question": {"decrement": {"shan_questions_left": 1}},
    "remember_missed_clue": {"append_unique": {"missed_critical_clues": "$clue_id"}}
  },
  "conditions_patch": {
    "route_verified": {"eq": ["route_verified", true]},
    "recall_recipient_found": {"eq": ["recall_recipient_found", true]},
    "shan_answer_recall": {"eq": ["shan_answer_recall", true]},
    "testimony_interpreted": {"eq": ["testimony_interpreted", true]},
    "shan_questions_available": {"gte": ["shan_questions_left", 1]},
    "divergent_ready_v02": {"all": ["route_verified", "recall_recipient_found", "shan_answer_recall", {"contains": ["clues_found", "military_order"]}]},
    "truth_ready_v02": {"all": ["testimony_interpreted", {"gte": ["evidence_completeness", 4]}, {"gte": ["inquiry_count", 3]}, {"lte": ["knowledge_debt", 2]}]}
  },
  "ending_rules_patch": {
    "ending_divergent": "divergent_ready_v02",
    "ending_canonical": "route_history_continues",
    "ending_truth": "truth_ready_v02"
  }
}
