  "scenes": [
    {
      "id": "s01_modern_article",
      "title": "序章｜读到一半",
      "year": 2026,
      "visual": "modern_dorm_to_ink_scroll",
      "beats": [
        {
          "id": "s01_b01",
          "speaker": "旁白",
          "text": "文章阅读进度停在 72%。屏幕上最后一行问：如果你知道一个人二十年后的结局，你会回去改变它吗？",
          "ui_slot": "dialogue_slot"
        },
        {
          "id": "s01_b02",
          "speaker": "系统",
          "text": "问题已被点击。请带着问题进入 1122 年。",
          "ui_slot": "dialogue_slot",
          "choices": [
            {
              "id": "s01_c01",
              "label": "点击“回到那个时候”",
              "effects": [
                "set_baby_state"
              ],
              "next_scene_id": "s02_baby_home"
            }
          ]
        }
      ]
    },
    {
      "id": "s02_baby_home",
      "title": "第一幕｜两岁的来客",
      "year": 1122,
      "visual": "low_angle_beam_and_cloth",
      "beats": [
        {
          "id": "s02_b01",
          "speaker": "旁白",
          "text": "屋梁压得很低。你只能看见衣料、手指、铜钱和一束从门缝落下的光。你现在只有两岁。",
          "ui_slot": "dialogue_slot"
        },
        {
          "id": "s02_b02",
          "speaker": "抚养者",
          "text": "粮价又涨了。北边的路，怕是越来越不太平。",
          "ui_slot": "dialogue_slot"
        },
        {
          "id": "s02_b03",
          "speaker": "旁白",
          "text": "你听不懂天下，只记住了声音。远处的马蹄，像墨点落在水面。",
          "ui_slot": "dialogue_slot",
          "choices": [
            {
              "id": "s02_c01",
              "label": "伸手触摸旧铜钱",
              "effects": [],
              "next_scene_id": "s03_baby_liushanshan"
            }
          ]
        }
      ]
    },
    {
      "id": "s03_baby_liushanshan",
      "title": "第一幕｜问题出现",
      "year": 1122,
      "visual": "paper_sky_fox",
      "beats": [
        {
          "id": "s03_b01",
          "speaker": "刘看山",
          "text": "这里是 1122 年，北宋末年。你还不能改变大事，但可以先记住一个答案。",
          "ui_slot": "dialogue_slot"
        },
        {
          "id": "s03_b02",
          "speaker": "玩家",
          "text": "岳飞还有多久会死？",
          "ui_slot": "dialogue_slot"
        },
        {
          "id": "s03_b03",
          "speaker": "刘看山",
          "text": "事实：史料记载岳飞在 1142 年离世。从 1122 年算起，大约二十年。背景：知道终点不代表知道谁会把人推向终点。反问：你准备先查哪一封信？",
          "ui_slot": "dialogue_slot",
          "effects": [
            "reveal_fate"
          ],
          "choices": [
            {
              "id": "s03_c01",
              "label": "记住这个答案",
              "effects": [
                "reveal_fate"
              ],
              "next_scene_id": "s04_growth_1127"
            }
          ]
        }
      ]
    },
    {
      "id": "s04_growth_1127",
      "title": "第二幕｜靖康之后",
      "year": 1127,
      "visual": "long_scroll_migration",
      "beats": [
        {
          "id": "s04_b01",
          "speaker": "旁白",
          "text": "时间向前翻页。1127 年，靖康之变后，北宋灭亡，南宋建立。你从会走路的孩子长成能读懂几行字的少年。",
          "ui_slot": "dialogue_slot"
        },
        {
          "id": "s04_b02",
          "speaker": "旁白",
          "text": "南宋不是一张地图，而是驿路、渡口、军镇和迁徙者共同撑起的一段日子。",
          "ui_slot": "dialogue_slot",
          "choices": [
            {
              "id": "s04_c01",
              "label": "前往驿站",
              "effects": [
                "advance_to_1127"
              ],
              "next_scene_id": "s05_station"
            }
          ]
        }
      ]
    },
    {
      "id": "s05_station",
      "title": "第二幕｜驿站的家书",
      "year": 1127,
      "visual": "station_lamp_and_letter",
      "beats": [
        {
          "id": "s05_b01",
          "speaker": "老驿卒",
          "text": "这封家书没有官印，却一路被人捎到这里。想知道消息怎么走，先看它经过谁的手。",
          "ui_slot": "dialogue_slot"
        },
        {
          "id": "s05_b02",
          "speaker": "旁白",
          "text": "线索卡：家书。它证明普通人的消息会沿着驿路移动，也会在每一次托付中改变。",
          "ui_slot": "clue_slot",
          "effects": [
            "find_family_letter"
          ]
        },
        {
          "id": "s05_b03",
          "speaker": "刘看山",
          "text": "事实：家书不是军令。背景：没有正式身份的消息，靠的是信任。反问：你要查送信路线，还是先问谁愿意替你作证？",
          "ui_slot": "dialogue_slot",
          "choices": [
            {
              "id": "s05_c01",
              "label": "询问送信路线",
              "effects": [
                "find_route_map",
                "ask_context"
              ],
              "next_scene_id": "s06_ferry"
            },
            {
              "id": "s05_c02",
              "label": "记下老驿卒的证言",
              "effects": [
                "ask_fact",
                "gain_military_trust"
              ],
              "next_scene_id": "s06_ferry"
            }
          ]
        }
      ]
    },
    {
      "id": "s06_ferry",
      "title": "第二幕｜渡口的证言",
      "year": 1132,
      "visual": "ferry_mist_and_refugees",
      "beats": [
        {
          "id": "s06_b01",
          "speaker": "迁徙者",
          "text": "我们不是叛军，也不是谁的数字。只想知道下一道命令会把我们赶到哪里。",
          "ui_slot": "dialogue_slot"
        },
        {
          "id": "s06_b02",
          "speaker": "旁白",
          "text": "线索卡：普通人证言。你可以保存这句话，也可以只带走路线。",
          "ui_slot": "clue_slot",
          "choices": [
            {
