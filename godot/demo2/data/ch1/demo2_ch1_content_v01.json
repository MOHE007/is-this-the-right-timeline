    {
      "id": "s09_recall_chain",
      "title": "第四幕｜1141 年的诏书",
      "year": 1141,
      "visual": "vermilion_edict_chain",
      "beats": [
        {
          "id": "s09_b01",
          "speaker": "旁白",
          "text": "你找到一份关于召回的诏书。它不是单一谜题，而是一条信息链：来源 → 路线 → 接收者 → 执行能力。",
          "ui_slot": "dialogue_slot"
        },
        {
          "id": "s09_b02",
          "speaker": "刘看山",
          "text": "事实：1141 年，岳飞被召回。背景：阻止一纸诏书，必须让预警可靠抵达，也必须有人愿意承担行动后果。反问：你要把时间交给军中接收者，还是先救正在迁徙的人？",
          "ui_slot": "dialogue_slot",
          "choices": [
            {
              "id": "s09_c01",
              "label": "把预警交给军中接收者",
