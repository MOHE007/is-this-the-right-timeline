                "ask_fact"
              ],
              "next_scene_id": "s09_recall_chain"
            },
            {
              "id": "s08_c02",
              "label": "问“为什么有人愿意执行？”",
              "effects": [
                "ask_context"
              ],
              "next_scene_id": "s09_recall_chain"
            },
            {
              "id": "s08_c03",
              "label": "问“如果预警提前抵达呢？”",
              "effects": [
                "ask_counterfactual"
