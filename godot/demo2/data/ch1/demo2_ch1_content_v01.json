          "id": "s07_b03",
          "speaker": "刘看山",
          "text": "事实：岳飞在抗金战事中逐渐成为关键将领。背景：军书的效力取决于组织与人。反问：你要继续查路线图，还是问一条命令为什么会被执行？",
          "ui_slot": "dialogue_slot",
          "choices": [
            {
              "id": "s07_c01",
              "label": "查路线图",
              "effects": [
                "ask_context"
              ],
              "next_scene_id": "s08_yuefei_countdown"
            },
            {
              "id": "s07_c02",
              "label": "追问执行能力",
              "effects": [
                "ask_counterfactual",
                "gain_military_trust"
              ],
              "next_scene_id": "s08_yuefei_countdown"
            }
          ]
        }
      ]
    },
