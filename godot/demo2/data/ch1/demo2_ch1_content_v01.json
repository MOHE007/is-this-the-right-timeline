              "label": "保存证言",
              "effects": [
                "hear_civilian_testimony",
                "ask_context"
              ],
              "next_scene_id": "s07_military_town"
            },
            {
              "id": "s06_c02",
              "label": "只记录路线",
              "effects": [
                "ask_fact",
                "find_route_map"
              ],
              "next_scene_id": "s07_military_town"
            }
          ]
        }
      ]
    },
    {
      "id": "s07_military_town",
      "title": "第三幕｜军镇里的军书",
      "year": 1138,
      "visual": "ink_town_banner_and_horse",
      "beats": [
        {
          "id": "s07_b01",
          "speaker": "军中同伴",
          "text": "军书写得很快，命令也来得很快。真正难的是：谁收到，谁相信，谁有能力照做。",
          "ui_slot": "dialogue_slot"
