        {
          "id": "s08_b03",
          "speaker": "刘看山",
          "text": "你已经可以提问三类问题：事实、背景、反事实。答案会越来越深，也会让你的知识债增加。",
          "ui_slot": "dialogue_slot",
          "choices": [
            {
              "id": "s08_c01",
              "label": "问“召回是什么事实？”",
              "condition": null,
