      }
    },
    "deliver_warning": {
      "set": {
        "warning_delivered": true,
        "recall_delayed": true
      },
      "increment": {
        "trust_military": 1
      }
    },
    "fail_delivery": {
      "set": {
        "warning_delivered": false,
        "recall_delayed": false
      }
    },
    "save_testimony": {
      "set": {
        "testimony_saved": true
      },
      "increment": {
        "trust_public": 1
      }
    },
    "set_ending_divergent": {
      "set": {
        "timeline": "divergent",
        "ending_id": "ending_divergent"
      }
    },
    "set_ending_canonical": {
      "set": {
        "timeline": "canonical",
        "ending_id": "ending_canonical"
      }
    },
    "set_ending_truth": {
      "set": {
        "timeline": "truth",
        "ending_id": "ending_truth"
      }
    },
    "choose_leave": {
      "set": {
